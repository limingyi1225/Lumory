build/
DerivedData/
.deriveddata*/
*.xcuserstate
*.xcuserdatad
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xcarchive

# Xcode - Swift packages / CocoaPods / Carthage
Pods/
Carthage/Build/
.build/
Package.resolved
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# Xcode - local secret-injection xcconfigs (never commit)
*.xcconfig.local
Lumory.local.xcconfig

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
Screenshots/**/*.png
# codex 终审 2026-05-19: screenshot 跑还会落 .mp4 录屏 / `Debug description ...txt` / `App UI hierarchy ...` byproducts。
# 老 ignore 只挡 png,这些 byproduct 很容易被 git add . 误带上。统一不入库。
# **第二轮**(codex 再审):`Synthesized Event ...` / `UI Snapshot ...` 这两个文件**没有扩展名**,
# 上面的 *.mp4 / *.txt 接不住;补两条以名字开头的 glob。
Screenshots/**/*.mp4
Screenshots/**/*.txt
Screenshots/**/App\ UI\ hierarchy*
Screenshots/**/Synthesized\ Event*
Screenshots/**/UI\ Snapshot*
fastlane/test_output

# Node / backend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
.env
.env.local
.env.*.local
server/.env

# Logs (including PM2 output)
*.log
logs/
server/logs/

